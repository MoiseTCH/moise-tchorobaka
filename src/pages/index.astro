---
import { defaultLocale } from '../i18n/config';
const target = `/${defaultLocale}/`;
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>Moïse Tchorobaka</title>
  </head>
  <body>
    <p>Redirecting… <a href={target}>Click here if you are not redirected automatically.</a></p>
  </body>
</html>