---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/sections/Section.astro';
import Breadcrumbs from '../../components/sections/Breadcrumbs.astro';
import FormField from '../../components/ui/FormField.astro';
import Button from '../../components/ui/Button.astro';
import { getLocaleStaticPaths } from '../../lib/localeParams';
import { buildLocalizedPath } from '../../i18n/utils';
import { t } from '../../i18n/ui-strings';
import { utilityPath } from '../../lib/routes';
import type { Locale } from '../../i18n/config';

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { lang } = Astro.params as { lang: Locale };
const settings = await getEntry('settings', `${lang}/site`);
if (!settings) throw new Error(`Missing settings entry for locale "${lang}"`);

const alternateHref = utilityPath(lang === 'en' ? 'fr' : 'en', 'contact');
const canonicalUrl = utilityPath(lang, 'contact');
const urlsByLocale = { en: utilityPath('en', 'contact'), fr: utilityPath('fr', 'contact') } as const;

const heading = lang === 'en' ? 'Contact' : 'Contact';
const description =
  lang === 'en'
    ? "Have a question, or not sure where to start? Get in touch."
    : "Une question, ou vous ne savez pas par où commencer ? Contactez-moi.";
const intro =
  lang === 'en'
    ? "For a specific translation, lesson, CV, website, or AI training request, use Get a Quote instead — it asks a couple of extra questions that help me reply faster. This form is for anything more general."
    : "Pour une demande précise de traduction, de cours, de CV, de site web ou de formation à l'IA, utilisez plutôt Demander un devis — quelques questions en plus permettent une réponse plus rapide. Ce formulaire convient pour toute autre demande.";
const quoteInsteadLabel = lang === 'en' ? 'Get a Quote instead' : 'Demander un devis à la place';
const nameLabel = lang === 'en' ? 'Name' : 'Nom';
const emailLabel = lang === 'en' ? 'Email' : 'E-mail';
const messageLabel = lang === 'en' ? 'Message' : 'Message';
const requiredLabel = t(lang, 'required');
const submitLabel = lang === 'en' ? 'Send Message' : 'Envoyer le message';
const sendingLabel = lang === 'en' ? 'Sending…' : 'Envoi en cours…';
const successMessage =
  lang === 'en'
    ? "Thanks — your message has been sent. I'll get back to you soon."
    : 'Merci — votre message a bien été envoyé. Je vous répondrai bientôt.';
const errorMessage =
  lang === 'en'
    ? 'Something went wrong sending this. Please try again, or email directly using the address below.'
    : "Une erreur est survenue lors de l'envoi. Merci de réessayer, ou d'écrire directement à l'adresse ci-dessous.";
const directContactHeading = lang === 'en' ? 'Direct contact' : 'Contact direct';
---

<BaseLayout locale={lang} title={`${heading} | Moïse Tchorobaka`} description={description} canonicalUrl={canonicalUrl} urlsByLocale={urlsByLocale} alternateHref={alternateHref}>
  <Section spacing="tight">
    <Container>
      <Breadcrumbs items={[{ label: t(lang, 'breadcrumbHome'), href: buildLocalizedPath(lang) }, { label: heading }]} />
    </Container>
  </Section>

  <Section spacing="default">
    <Container>
      <div class="grid gap-8 md:grid-cols-[2fr_1fr]">
        <div>
          <h1>{heading}</h1>
          <p class="prose-measure mt-4 text-body-lg">{intro}</p>
          <p class="mt-2">
            <a href={utilityPath(lang, 'quote')} class="btn-tertiary">{quoteInsteadLabel} →</a>
          </p>

          <!--
            Netlify Forms convention: data-netlify + a matching hidden
            form-name field is what lets Netlify's build bots detect and
            provision this form with zero API keys or secrets. See
            src/lib/formSubmit.ts for the full integration note, including
            what changes if this project deploys somewhere other than
            Netlify.
          -->
          <form
            class="mt-8 flex max-w-[60ch] flex-col gap-4"
            data-form="contact"
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            data-sending-label={sendingLabel}
            data-success-message={successMessage}
            data-error-message={errorMessage}
          >
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden">
              <label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
            </p>
            <FormField type="text" name="name" label={nameLabel} required requiredLabel={requiredLabel} />
            <FormField type="email" name="email" label={emailLabel} required requiredLabel={requiredLabel} />
            <FormField type="textarea" name="message" label={messageLabel} required requiredLabel={requiredLabel} />
            <div>
              <Button type="submit" variant="primary">{submitLabel}</Button>
            </div>
            <p data-form-status aria-live="polite" class="text-body-sm"></p>
          </form>
        </div>

        <div>
          <h2 class="text-h4 font-body">{directContactHeading}</h2>
          <ul class="mt-3 flex flex-col gap-2 text-body-sm">
            <li><a href={`mailto:${settings.data.contact_email}`} class="text-cobalt">{settings.data.contact_email}</a></li>
            {settings.data.phone && <li><a href={`tel:${settings.data.phone}`} class="text-cobalt">{settings.data.phone}</a></li>}
            {settings.data.whatsapp_number && (
              <li>
                <a href={`https://wa.me/${settings.data.whatsapp_number.replace(/[^\d]/g, '')}`} class="text-cobalt" target="_blank" rel="noopener noreferrer">
                  WhatsApp
                </a>
              </li>
            )}
            {settings.data.social_links?.map((s) => (
              <li><a href={s.url} class="text-cobalt">{s.platform}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>

<script>
  import { initFormHandler } from '../../lib/formSubmit';

  const form = document.querySelector<HTMLFormElement>('[data-form="contact"]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');
  if (form && status) {
    initFormHandler(form, status, {
      sendingLabel: form.dataset.sendingLabel ?? 'Sending…',
      successMessage: form.dataset.successMessage ?? '',
      errorMessage: form.dataset.errorMessage ?? '',
    });
  }
</script>
