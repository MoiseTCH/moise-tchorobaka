---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Section from '../../../components/sections/Section.astro';
import Breadcrumbs from '../../../components/sections/Breadcrumbs.astro';
import CTABand from '../../../components/sections/CTABand.astro';
import { buildLocalizedPath } from '../../../i18n/utils';
import { resolveAlternateEntry } from '../../../i18n/content-pairing';
import { t } from '../../../i18n/ui-strings';
import { utilityPath } from '../../../lib/routes';
import type { Locale } from '../../../i18n/config';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const allItems = await getCollection('portfolio');
  return allItems.map((entry) => {
    const lang = entry.id.split('/')[0] as Locale;
    return { params: { lang, slug: entry.data.url_slug }, props: { entry } };
  });
}

interface Props {
  entry: CollectionEntry<'portfolio'>;
}

const { entry } = Astro.props;
const { lang } = Astro.params as { lang: Locale };
const { Content: ProjectBody } = await entry.render();

const alternateEntry = await resolveAlternateEntry('portfolio', entry.id, lang);
const alternateLocale = lang === 'en' ? 'fr' : 'en';
const alternateHref = alternateEntry ? buildLocalizedPath(alternateLocale, 'portfolio', alternateEntry.data.url_slug) : null;

const canonicalUrl = buildLocalizedPath(lang, 'portfolio', entry.data.url_slug);
const urlsByLocale = {
  [lang]: canonicalUrl,
  ...(alternateHref ? { [alternateLocale]: alternateHref } : {}),
} as Partial<Record<Locale, string>>;

const ctaLabel = lang === 'en' ? 'Get a Quote' : 'Demander un devis';
const ctaHeading = lang === 'en' ? 'Interested in something similar?' : 'Intéressé par quelque chose de similaire ?';
---

<BaseLayout
  locale={lang}
  title={entry.data.seo?.seo_title ?? entry.data.title}
  description={entry.data.seo?.seo_description ?? entry.data.description}
  canonicalUrl={canonicalUrl}
  urlsByLocale={urlsByLocale}
  alternateHref={alternateHref}
>
  <Section spacing="tight">
    <Container>
      <Breadcrumbs items={[{ label: t(lang, 'breadcrumbHome'), href: buildLocalizedPath(lang) }, { label: 'Portfolio', href: utilityPath(lang, 'portfolio') }, { label: entry.data.title }]} />
    </Container>
  </Section>

  <Section spacing="default">
    <Container>
      <h1>{entry.data.title}</h1>
      <p class="prose-measure mt-4 text-body-lg">{entry.data.description}</p>

      {entry.data.image ? (
        <img src={entry.data.image} alt={entry.data.image_alt ?? ''} width={960} height={640} loading="lazy" class="mt-6 w-full rounded-card object-cover" />
      ) : entry.data.before_text ? (
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          <div class="card font-mono text-mono text-graphite">{entry.data.before_text}</div>
          {entry.data.after_text && <div class="card font-mono text-mono text-graphite">{entry.data.after_text}</div>}
        </div>
      ) : null}

      <div class="prose-measure markdown-content mt-8">
        <ProjectBody />
      </div>

      {entry.data.tools && entry.data.tools.length > 0 && (
        <p class="mt-6 text-body-sm text-graphite">{entry.data.tools.join(' · ')}</p>
      )}

      {entry.data.external_link && (
        <p class="mt-4">
          <a href={entry.data.external_link} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
            {entry.data.external_link}
          </a>
        </p>
      )}
    </Container>
  </Section>

  <Section spacing="default">
    <Container>
      <CTABand heading={ctaHeading} ctaLabel={ctaLabel} ctaHref={utilityPath(lang, 'quote')} />
    </Container>
  </Section>
</BaseLayout>
