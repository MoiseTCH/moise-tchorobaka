---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Section from '../../../components/sections/Section.astro';
import Breadcrumbs from '../../../components/sections/Breadcrumbs.astro';
import { buildLocalizedPath } from '../../../i18n/utils';
import { resolveAlternateEntry } from '../../../i18n/content-pairing';
import { t } from '../../../i18n/ui-strings';
import type { Locale } from '../../../i18n/config';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const legalPages = await getCollection('pages', (e) => e.data.page_type === 'legal');
  return legalPages.map((entry) => {
    const lang = entry.id.split('/')[0] as Locale;
    return { params: { lang, slug: entry.data.url_slug }, props: { entry } };
  });
}

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const { lang } = Astro.params as { lang: Locale };
const { Content: LegalBody } = await entry.render();

const alternateEntry = await resolveAlternateEntry('pages', entry.id, lang);
const alternateLocale: Locale = lang === 'en' ? 'fr' : 'en';
const alternateHref = alternateEntry ? buildLocalizedPath(alternateLocale, alternateEntry.data.url_slug) : null;

const canonicalUrl = buildLocalizedPath(lang, entry.data.url_slug);
const urlsByLocale = {
  [lang]: canonicalUrl,
  ...(alternateHref ? { [alternateLocale]: alternateHref } : {}),
} as Partial<Record<Locale, string>>;
---

<BaseLayout
  locale={lang}
  title={entry.data.seo?.seo_title ?? entry.data.title}
  description={entry.data.seo?.seo_description ?? entry.data.description}
  canonicalUrl={canonicalUrl}
  urlsByLocale={urlsByLocale}
  alternateHref={alternateHref}
>
  <Section spacing="tight">
    <Container>
      <Breadcrumbs items={[{ label: t(lang, 'breadcrumbHome'), href: buildLocalizedPath(lang) }, { label: entry.data.title }]} />
    </Container>
  </Section>

  <Section spacing="default">
    <Container>
      <h1>{entry.data.hero_heading ?? entry.data.title}</h1>
      <div class="prose-measure mt-6">
        <LegalBody />
      </div>
    </Container>
  </Section>
</BaseLayout>
