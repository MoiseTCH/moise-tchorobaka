---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Section from '../../../components/sections/Section.astro';
import Breadcrumbs from '../../../components/sections/Breadcrumbs.astro';
import CTABand from '../../../components/sections/CTABand.astro';
import FAQItem from '../../../components/sections/FAQItem.astro';
import PortfolioCard from '../../../components/cards/PortfolioCard.astro';
import TestimonialCard from '../../../components/cards/TestimonialCard.astro';
import ServiceCard from '../../../components/cards/ServiceCard.astro';
import Icon from '../../../components/ui/Icon.astro';
import StructuredData from '../../../components/sections/StructuredData.astro';
import { serviceSchema, breadcrumbSchema, faqPageSchema } from '../../../lib/schema';
import { buildLocalizedPath } from '../../../i18n/utils';
import { resolveAlternateEntry } from '../../../i18n/content-pairing';
import { t } from '../../../i18n/ui-strings';
import { getFaqs, getPublishedTestimonials } from '../../../lib/content';
import { utilityPath } from '../../../lib/routes';
import type { Locale } from '../../../i18n/config';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const allServices = await getCollection('services');
  return allServices.map((entry) => {
    const lang = entry.id.split('/')[0] as Locale;
    return {
      params: { lang, slug: entry.data.url_slug },
      props: { entry },
    };
  });
}

interface Props {
  entry: CollectionEntry<'services'>;
}

const { entry } = Astro.props;
const { lang } = Astro.params as { lang: Locale };
const { Content: ServiceBody } = await entry.render();

const stableSlug = entry.id.split('/').slice(1).join('/');

const alternateEntry = await resolveAlternateEntry('services', entry.id, lang);
const alternateLocale = lang === 'en' ? 'fr' : 'en';
const alternateHref = alternateEntry ? buildLocalizedPath(alternateLocale, 'services', alternateEntry.data.url_slug) : null;

const canonicalUrl = buildLocalizedPath(lang, 'services', entry.data.url_slug);
const urlsByLocale = {
  [lang]: canonicalUrl,
  ...(alternateHref ? { [alternateLocale]: alternateHref } : {}),
} as Partial<Record<Locale, string>>;

// Related content, all resolved from the stable, locale-agnostic slug —
// this is exactly the pairing mechanism proved in the Stage 4/5
// integration trace.
const relatedFaqs = await getFaqs(lang, { serviceSlug: stableSlug });

const settings = await getEntry('settings', `${lang}/site`);
const siteUrl = Astro.site ? Astro.site.href : '/';
const breadcrumbItems = [
  { label: t(lang, 'breadcrumbHome'), href: buildLocalizedPath(lang) },
  { label: entry.data.title },
];
const structuredData = [
  serviceSchema(entry, siteUrl, settings?.data.site_name ?? 'Moïse Tchorobaka', canonicalUrl),
  breadcrumbSchema(breadcrumbItems, siteUrl),
  faqPageSchema(relatedFaqs),
];
const relatedTestimonials = await getPublishedTestimonials(lang, stableSlug);

const allServicesThisLocale = await getCollection('services', (e) => e.id.startsWith(`${lang}/`));
const crossLinked = (entry.data.cross_linked_services ?? [])
  .map((slug) => allServicesThisLocale.find((s) => s.id.split('/').slice(1).join('/') === slug))
  .filter((s): s is CollectionEntry<'services'> => Boolean(s));

const relatedPortfolio = (await getCollection('portfolio', (e) => e.id.startsWith(`${lang}/`))).filter(
  (p) => p.data.service_category === stableSlug
);

const learnMoreLabel = lang === 'en' ? 'Learn more' : 'En savoir plus';
const newBadgeLabel = lang === 'en' ? 'New' : 'Nouveau';
const categoryLabel = lang === 'en' ? 'Portfolio' : 'Portfolio';
const whoItsForHeading = lang === 'en' ? "Who this is for" : 'Pour qui';
const whatsIncludedHeading = lang === 'en' ? "What's included" : 'Ce qui est inclus';
const processHeading = lang === 'en' ? 'How it works' : 'Comment ça se passe';
const proofHeading = lang === 'en' ? 'Related work' : 'Travaux liés';
const testimonialsHeading = lang === 'en' ? 'What clients say' : 'Ce que disent les clients';
const faqHeading = lang === 'en' ? 'Questions about this service' : 'Questions sur ce service';
const relatedServicesHeading = lang === 'en' ? 'Related services' : 'Services associés';
---

<BaseLayout
  locale={lang}
  title={entry.data.seo?.seo_title ?? entry.data.title}
  description={entry.data.seo?.seo_description ?? entry.data.short_description}
  canonicalUrl={canonicalUrl}
  urlsByLocale={urlsByLocale}
  alternateHref={alternateHref}
>
  <StructuredData schema={structuredData} />
  <Section spacing="tight">
    <Container>
      <Breadcrumbs items={breadcrumbItems} />
    </Container>
  </Section>

  <Section spacing="default">
    <Container>
      <Icon
        name={entry.data.icon}
        class={`h-10 w-10 mb-3 ${entry.data.accent_color === 'marigold' ? 'text-marigold' : 'text-cobalt'}`}
      />
      <h1>{entry.data.title}</h1>
      <p class="prose-measure mt-4 text-body-lg">{entry.data.short_description}</p>
      <div class="mt-4">
        <a href="#quote-cta" class="btn btn-primary">{entry.data.cta_label}</a>
      </div>

      <div class="prose-measure markdown-content mt-8">
        <ServiceBody />
      </div>

      {entry.data.target_audience && entry.data.target_audience.length > 0 && (
        <div class="mt-8">
          <h2 class="text-h4 font-body">{whoItsForHeading}</h2>
          <ul class="mt-3 flex flex-col gap-2">
            {entry.data.target_audience.map((a) => (
              <li class="flex gap-2"><span aria-hidden="true" class="text-cobalt">—</span>{a}</li>
            ))}
          </ul>
        </div>
      )}

      {entry.data.benefits && entry.data.benefits.length > 0 && (
        <div class="mt-8">
          <h2 class="text-h4 font-body">{whatsIncludedHeading}</h2>
          <ul class="mt-3 flex flex-col gap-2">
            {entry.data.benefits.map((b) => (
              <li class="flex gap-2"><span aria-hidden="true" class="text-cobalt">—</span>{b}</li>
            ))}
          </ul>
        </div>
      )}

      {entry.data.process_steps && entry.data.process_steps.length > 0 && (
        <div class="mt-8">
          <h2 class="text-h4 font-body">{processHeading}</h2>
          <ol class="mt-4 grid gap-4 md:grid-cols-3">
            {entry.data.process_steps.map((step, i) => (
              <li class="card">
                <p class="font-mono text-mono text-cobalt">{i + 1}</p>
                <p class="mt-1 font-semibold text-ink-navy">{step.step_title}</p>
                <p class="mt-1 text-body-sm">{step.step_description}</p>
              </li>
            ))}
          </ol>
        </div>
      )}

      {entry.data.pricing_note && <p class="prose-measure mt-8 text-body-sm text-graphite">{entry.data.pricing_note}</p>}
    </Container>
  </Section>

  {relatedPortfolio.length > 0 && (
    <Section spacing="default">
      <Container>
        <h2>{proofHeading}</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-3">
          {relatedPortfolio.map((item) => (
            <PortfolioCard item={item} href={buildLocalizedPath(lang, 'portfolio', item.data.url_slug)} categoryLabel={categoryLabel} />
          ))}
        </div>
      </Container>
    </Section>
  )}

  {relatedTestimonials.length > 0 && (
    <Section spacing="default" theme="dark">
      <Container>
        <h2 class="text-cloud">{testimonialsHeading}</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-3">
          {relatedTestimonials.map((tItem) => <TestimonialCard testimonial={tItem} />)}
        </div>
      </Container>
    </Section>
  )}

  {relatedFaqs.length > 0 && (
    <Section spacing="default">
      <Container>
        <h2>{faqHeading}</h2>
        <div class="mt-6 flex flex-col gap-3">
          {relatedFaqs.map((faq) => <FAQItem faq={faq} />)}
        </div>
      </Container>
    </Section>
  )}

  {crossLinked.length > 0 && (
    <Section spacing="default">
      <Container>
        <h2>{relatedServicesHeading}</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {crossLinked.map((s) => (
            <ServiceCard service={s} locale={lang} href={buildLocalizedPath(lang, 'services', s.data.url_slug)} learnMoreLabel={learnMoreLabel} newBadgeLabel={newBadgeLabel} />
          ))}
        </div>
      </Container>
    </Section>
  )}

  <Section spacing="default">
    <Container>
      <div id="quote-cta">
        <CTABand heading={entry.data.cta_label} ctaLabel={entry.data.cta_label} ctaHref={`${utilityPath(lang, 'quote')}?service=${stableSlug}`} />
      </div>
    </Container>
  </Section>
</BaseLayout>
