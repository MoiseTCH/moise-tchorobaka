---
export interface Props {
  href?: string;
  class?: string;
}

const { href, class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
const linkProps = href ? { href } : {};
---

<Tag {...linkProps} class={`card block no-underline text-inherit ${className}`.trim()}>
  <slot />
</Tag>
