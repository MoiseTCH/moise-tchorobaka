---
import type { CollectionEntry } from 'astro:content';

/*
  Autonomous improvement over the originally-planned implementation: the
  approved design system anticipated a JS-hydrated accordion component.
  Native <details>/<summary> gives the identical visual result while
  being keyboard-operable and screen-reader-friendly with zero JavaScript
  and no ARIA needed at all — a direct application of "don't use ARIA as
  a substitute for correct semantic HTML." Flagged in the Stage 4/5 report.

  NOTE: `answer` is a markdown-capable field in the CMS (so the site owner
  can use *emphasis* etc. if they want to), but is rendered here as plain
  text rather than parsed HTML. Rendering it as HTML would need a markdown
  parser and introduces injection-surface considerations for no real
  benefit at typical FAQ-answer length; if rich formatting is genuinely
  needed later, a markdown-render step can be added without any schema
  change. This is a deliberate simplicity trade-off, not an oversight.
*/
export interface Props {
  faq: CollectionEntry<'faqs'>;
}

const { faq } = Astro.props;
const { question, answer } = faq.data;
---

<details class="card group">
  <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-semibold text-ink-navy marker:content-none">
    <span>{question}</span>
    <span aria-hidden="true" class="shrink-0 text-h4 leading-none text-cobalt transition-transform group-open:rotate-45">+</span>
  </summary>
  <div class="prose-measure text-body-sm mt-3">{answer}</div>
</details>
