---
export interface Crumb {
  label: string;
  href?: string;
}

export interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-body-sm">
  <ol class="flex flex-wrap items-center gap-2">
    {
      items.map((item, i) => {
        const isLast = i === items.length - 1;
        return (
          <li class="flex items-center gap-2">
            {item.href && !isLast ? (
              <a href={item.href} class="text-cobalt no-underline hover:underline">
                {item.label}
              </a>
            ) : (
              <span aria-current={isLast ? 'page' : undefined} class="text-graphite">
                {item.label}
              </span>
            )}
            {!isLast && (
              <span aria-hidden="true" class="text-mist">
                /
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
