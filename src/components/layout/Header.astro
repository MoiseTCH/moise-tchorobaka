---
import LanguageSwitcher from './LanguageSwitcher.astro';
import Button from '../ui/Button.astro';
import { t } from '../../i18n/ui-strings';
import type { Locale } from '../../i18n/config';

/*
  Content-agnostic by design: nav labels, the CTA label, and the site name
  are all passed in by the caller (sourced from the `settings` CMS
  collection at the page-assembly level, which comes in a later stage)
  rather than hardcoded here — this is what lets the exact same component
  render either language correctly.
*/
export interface NavLink {
  label: string;
  href: string;
}

export interface Props {
  locale: Locale;
  siteName: string;
  navLinks: NavLink[];
  ctaLabel: string;
  ctaHref: string;
  alternateHref: string | null;
  alternateLabel: string;
}

const { locale, siteName, navLinks, ctaLabel, ctaHref, alternateHref, alternateLabel } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-transparent bg-paper transition-colors [&.is-scrolled]:border-mist" data-header>
  <div class="container flex items-center justify-between gap-4 py-3">
    <a href={`/${locale}/`} class="flex items-center gap-3 font-display text-h4 text-ink-navy no-underline">
      <img src="/logo-icon.png" alt="" width="36" height="36" class="h-9 w-9 rounded-md" />
      {siteName}
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link">
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-4 md:flex">
      <LanguageSwitcher locale={locale} alternateHref={alternateHref} alternateLabel={alternateLabel} />
      <Button href={ctaHref} variant="primary">
        {ctaLabel}
      </Button>
    </div>

    <div class="flex items-center gap-2 md:hidden">
      <LanguageSwitcher locale={locale} alternateHref={alternateHref} alternateLabel={alternateLabel} compact />
      <button type="button" class="nav-link" data-menu-toggle aria-expanded="false" aria-controls="mobile-nav">
        <span data-menu-toggle-label>{t(locale, 'openMenu')}</span>
      </button>
    </div>
  </div>

  <div
    id="mobile-nav"
    class="theme-dark fixed inset-0 z-40 hidden flex-col overflow-y-auto p-6 md:hidden"
    data-mobile-nav
    role="dialog"
    aria-modal="true"
    aria-label={t(locale, 'openMenu')}
  >
    <div class="flex justify-end">
      <button type="button" class="nav-link" data-menu-close>
        {t(locale, 'closeMenu')}
      </button>
    </div>
    <nav class="mt-6 flex flex-col gap-2" aria-label="Primary">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link text-h4">
          {link.label}
        </a>
      ))}
    </nav>
    <div class="mt-auto pt-6">
      <Button href={ctaHref} variant="primary" class="w-full">
        {ctaLabel}
      </Button>
    </div>
  </div>
</header>

<script>
  // Plain vanilla JS — this interaction (toggle + focus handling + Escape
  // to close) doesn't warrant a hydrated component-framework island.
  // Scoped with feature checks so it fails safe if an element is missing.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-nav]');

  function openMenu() {
    if (!menu || !toggle) return;
    menu.classList.remove('hidden');
    menu.classList.add('flex');
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    const firstFocusable = menu.querySelector<HTMLElement>('a, button');
    firstFocusable?.focus();
  }

  function closeMenu() {
    if (!menu || !toggle) return;
    menu.classList.add('hidden');
    menu.classList.remove('flex');
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    toggle.focus();
  }

  toggle?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.classList.contains('hidden')) {
      closeMenu();
    }
  });

  // Subtle sticky border once the page has scrolled, per the design system.
  function onScroll() {
    if (!header) return;
    if (window.scrollY > 8) header.classList.add('is-scrolled');
    else header.classList.remove('is-scrolled');
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
